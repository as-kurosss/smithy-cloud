DATABASE_URL=postgresql+asyncpg://smithy:smithy_dev_password@localhost:5432/smithy_cloud
# Comma-separated list is parsed by pydantic-settings as JSON: '["http://localhost:3000"]'
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
# Local dev-run log ingest (LocalBackend opt-in sink). Never enable in prod.
LOCAL_INGEST_ENABLED=false
# Create tables on startup (dev convenience). Prod uses Alembic.
DEV_CREATE_TABLES=false
